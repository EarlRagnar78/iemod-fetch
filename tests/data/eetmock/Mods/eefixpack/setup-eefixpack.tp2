// Excerpt for iemod-fetch's mock EET test: the install-time constraint lines of
// components [0, 1, 2] only, verbatim from https://github.com/Gibberlings3/EE_Fixpack @ 3776989 (eefixpack/setup-eefixpack.tp2).
// Not installable; the mod's own licence applies to these lines.
BEGIN @0 DESIGNATED 0
REQUIRE_PREDICATE !GAME_IS ~eet~ @11
REQUIRE_PREDICATE (((GAME_IS ~bgee~)  AND (FILE_EXISTS ~eefixpack/files/tph/bgee.tph~)) OR
LABEL ~cd_eefp_core_fixes~
BEGIN @1 DESIGNATED 1
REQUIRE_PREDICATE !GAME_IS ~eet~ @11
REQUIRE_PREDICATE (((GAME_IS ~bgee~)  AND (FILE_EXISTS ~eefixpack/files/tph/bgee_beta.tph~)) OR
LABEL ~cd_eefp_beta_core_fixes~
BEGIN @2 DESIGNATED 2
REQUIRE_PREDICATE !GAME_IS ~eet~ @11
REQUIRE_PREDICATE (("%EE_LANGUAGE%" STRING_COMPARE_CASE "%LANGUAGE%" = 0) AND
LABEL ~cd_eefp_game_text_update~
