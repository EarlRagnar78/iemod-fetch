{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gsamuele78/iemod-fetch/schemas/events-v1.schema.json",
  "title": "iemod-fetch progress event, version 1",
  "description": "One line of --events (JSON Lines), and the dict a Runner's on_event receives. iemod_fetch/runner.py is the authority.",
  "type": "object",
  "required": ["schema_version", "event"],
  "properties": {"schema_version": {"const": 1}},
  "oneOf": [
    {"properties": {"event": {"const": "run_started"}, "mods": {"type": "integer"}},
     "required": ["mods"]},
    {"properties": {"event": {"const": "mod_started"}, "folder": {"type": "string"}},
     "required": ["folder"]},
    {"properties": {"event": {"const": "download_progress"}, "folder": {"type": "string"},
                    "bytes": {"type": "integer"}, "total": {"type": ["integer", "null"]}},
     "required": ["folder", "bytes", "total"]},
    {"properties": {"event": {"const": "mod_extracting"}, "folder": {"type": "string"}},
     "required": ["folder"]},
    {"properties": {"event": {"const": "mod_finished"}, "folder": {"type": "string"},
                    "status": {"enum": ["ok", "skipped", "planned", "manual", "conflict",
                                        "failed", "cancelled"]},
                    "detail": {"type": "string"}},
     "required": ["folder", "status", "detail"]},
    {"properties": {"event": {"const": "run_finished"}, "cancelled": {"type": "boolean"},
                    "counts": {"type": "object"}},
     "required": ["cancelled", "counts"]},
    {"properties": {"event": {"const": "data_source"}, "name": {"type": "string"},
                    "status": {"enum": ["fresh", "current", "updated", "rejected", "failed"]},
                    "commit": {"type": "string"}, "date": {"type": "string"},
                    "changed": {"type": "integer"}, "detail": {"type": "string"},
                    "changes": {"type": "object"}},
     "required": ["name", "status", "commit", "date", "changed", "detail"]}
  ]
}
