root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# WeiDU writes CRLF and its own encoding. These are fixtures of real files:
# normalising them would destroy what they are evidence of.
[tests/data/*.log]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
